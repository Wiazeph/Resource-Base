# Sanity — Project settings (Project ID & dataset from sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only read token (Viewer role). Used by the public site's read client. NEVER expose to the browser.
SANITY_API_READ_TOKEN=

# Server-only write token (Editor role). Used by migration script, /api/submit and cron. NEVER expose to the browser.
SANITY_API_WRITE_TOKEN=

# Secret shared with the Sanity webhook that triggers on-demand revalidation
SANITY_REVALIDATE_SECRET=

# Secret Vercel injects into the cron route Authorization header
CRON_SECRET=

# Public site URL (used for sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
