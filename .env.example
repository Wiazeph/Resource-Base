# ── Sanity (content) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only read token (Viewer role) — public site read client. Never client-side.
SANITY_API_READ_TOKEN=
# Server-only write token (Editor role) — migration, submissions, cron. Never client-side.
SANITY_API_WRITE_TOKEN=
# Secret shared with the Sanity webhook that triggers on-demand revalidation
SANITY_REVALIDATE_SECRET=
# Secret shared with the Sanity webhook that fires submission-approval notifications
SANITY_NOTIFY_SECRET=

# ── Supabase (auth + user data) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — full DB access for click increments and notification writes. Never client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel / misc ───────────────────────────────────────────────────────────
# Secret Vercel injects into the cron route Authorization header
CRON_SECRET=
# Public site URL (sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
